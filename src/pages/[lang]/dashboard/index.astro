---
import Layout from '~/layouts/Layout.astro';
import { loadLocale, getLanguagePaths } from '~/lib/i18n';

export function getStaticPaths() {
  return getLanguagePaths();
}

const { lang } = Astro.params;
const m = loadLocale(lang);

const metadata = {
  title: 'Renoir Application Monitor | Dashboard',
  description: 'Interactive monitoring simulation for Renoir data processing pipelines.'
};
---

<Layout metadata={metadata}>
  <!-- Load Neobrutalist Dashboard Styles -->
  <link rel="stylesheet" href="/dashboard/style.css" />

  <!-- SVG Hand-Drawn Filter definition -->
  <svg class="svg-filters" style="position: absolute; width: 0; height: 0;" aria-hidden="true">
    <defs>
      <!-- Filter to make borders look hand-drawn and slightly wavy -->
      <filter id="hand-drawn-filter">
        <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="3" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <!-- Hand-drawn arrow markers -->
      <marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 1 L 10 5 L 0 9 z" fill="#2d3748" />
      </marker>
      <marker id="arrow-green" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 1 L 10 5 L 0 9 z" fill="#2b8a3e" />
      </marker>
      <marker id="arrow-dark" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 1 L 10 5 L 0 9 z" fill="#9ca3af" />
      </marker>
      <marker id="arrow-black" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 1 L 10 5 L 0 9 z" fill="#000000" />
      </marker>
      <marker id="arrow-white" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 1 L 10 5 L 0 9 z" fill="#ffffff" />
      </marker>
    </defs>
  </svg>

  <div class="w-full max-w-none px-4 sm:px-8 lg:px-12 py-12">
    
    <!-- Redesigned Neobrutalist Dashboard Header -->
    <div class="border-4 border-black bg-white p-6 neo-shadow flex flex-col md:flex-row items-center justify-between gap-4 mb-8">
      <div class="flex items-center gap-3">
        <div class="w-16 h-16 border-4 border-black flex items-center justify-center font-black text-2xl neo-shadow select-none text-black">
                 <!-- <div class="absolute top-1 right-1 w-14 h-14 bg-white border-2 border-purple-600 neo-shadow flex items-center justify-center p-1 shrink-0 select-none"> -->
            <img src="/assets/Renoir.png" alt="Renoir Logo" class="w-full h-full object-contain" />
          <!-- </div> -->
        </div>
        <div>
          <h1 class="font-black text-2xl uppercase leading-none text-black">{m.db_title()}</h1>
          <p class="font-mono text-xs text-gray-500 mt-1">{m.db_subtitle()}</p>
        </div>
      </div>
      
      <!-- Target status indicator for app.js and Dropdown Menu -->
      <div class="status-summary flex flex-wrap items-center gap-4">
        <div class="status-indicator-box healthy" id="global-status-indicator">
          <span class="status-dot"></span>
          <span class="status-label">{m.db_status_healthy()}</span>
        </div>

        <!-- Controls Dropdown wrapper -->
        <div class="relative inline-block text-left" id="controls-dropdown-wrapper">
          <button 
            type="button" 
            class="sketch-btn font-black text-sm uppercase px-4 py-2 border-2 border-black bg-color-chart-3 text-black hover:bg-yellow-300 neo-shadow flex items-center gap-2" 
            id="btn-dropdown-toggle"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>⚙️</span> {m.db_controls_btn()} <span class="transition-transform duration-200" id="dropdown-arrow">▼</span>
          </button>
          
          <!-- Dropdown menu panel -->
          <div 
            class="hidden absolute right-0 mt-2 w-72 origin-top-right border-4 border-black bg-white neo-shadow p-4 z-50 flex flex-col gap-4" 
            role="menu" 
            aria-orientation="vertical" 
            aria-labelledby="btn-dropdown-toggle"
            id="controls-dropdown-menu"
          >
            <div class="font-black text-xs uppercase text-gray-500 border-b-2 border-black pb-1 mb-1">// {m.db_controls_title()}</div>
            
            <button class="sketch-btn active font-black text-xs uppercase px-3 py-2 border-2 border-black bg-color-chart-3 text-black hover:bg-yellow-300 w-full justify-center" id="btn-play-pause">
              <span class="icon">⏸</span> {m.db_btn_pause()}
            </button>
            
            <button class="sketch-btn font-black text-xs uppercase px-3 py-2 border-2 border-black bg-white text-black hover:bg-gray-50 w-full justify-center" id="btn-inject-warning">
              <span class="icon">⚠️</span> {m.db_btn_inject_warn()}
            </button>
            
            <button class="sketch-btn font-black text-xs uppercase px-3 py-2 border-2 border-black bg-white text-black hover:bg-gray-50 w-full justify-center" id="btn-clear-selection">
              <span class="icon">✨</span> {m.db_btn_reset()}
            </button>
            
            <div class="border-t-2 border-dashed border-black pt-3 flex flex-col gap-2 font-bold text-xs text-black">
              <label for="simulation-speed">{m.db_throughput_scale()}</label>
              <div class="flex items-center justify-between gap-2">
                <input type="range" id="simulation-speed" min="0.2" max="3" step="0.1" value="1" class="accent-black w-full">
                <span id="speed-value" class="font-mono bg-black text-white px-2 py-0.5 shrink-0">1.0x</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Scenario Selector Toolbar -->
    <div class="border-4 border-black bg-white p-4 neo-shadow flex flex-col md:flex-row items-center justify-between gap-4 mb-8 text-black">
      <div class="flex items-center gap-2">
        <span class="text-lg font-black uppercase">{m.db_scenario_label()}</span>
        <span class="font-mono text-xs text-gray-500">{m.db_scenario_sub()}</span>
      </div>
      <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
        <button class="scenario-btn active sketch-btn text-xs font-black uppercase px-4 py-2 border-2 border-black bg-color-chart-1 text-black w-full md:w-auto" data-scenario="financial">
          🏦 {m.db_scenario_financial()}
        </button>
        <button class="scenario-btn sketch-btn text-xs font-black uppercase px-4 py-2 border-2 border-black bg-white text-black w-full md:w-auto" data-scenario="iot">
          ⚡ {m.db_scenario_iot()}
        </button>
        <button class="scenario-btn sketch-btn text-xs font-black uppercase px-4 py-2 border-2 border-black bg-white text-black w-full md:w-auto" data-scenario="cdn">
          🌐 {m.db_scenario_cdn()}
        </button>
      </div>
    </div>

    <!-- Main Content Grid -->
    <main class="app-content">
      <!-- DAG Area -->
      <section class="dag-section">
        <div class="dag-outer-card border-4 border-black bg-white neo-shadow p-6 flex flex-col">
          <div class="dag-card-header border-b-2 border-black pb-4 mb-4">
            <h2 class="font-black text-xl uppercase text-black">{m.db_topology_title()}</h2>
            <p class="text-xs text-gray-500 font-mono mt-1">{m.db_topology_instruction()}</p>
          </div>

          <!-- Topology Container -->
          <div class="dag-canvas-container border-4 border-black relative overflow-hidden h-[500px]" id="dag-container">
            <div id="dag-viewport" class="w-full h-full relative">
              <!-- Background SVG for lines and particle animations -->
              <svg class="dag-connections-svg w-full h-full absolute inset-0" id="connections-svg">
                <!-- JS will dynamically populate connection paths here -->
              </svg>

              <!-- Dynamic HTML Nodes will be generated and positioned absolutely by JS -->
            </div>
          </div>
        </div>

        <!-- Data Inspector / Node Explainability Panel -->
        <div class="explainability-card border-4 border-black bg-white neo-shadow p-6 hidden" id="explainability-card">
          <div class="explainability-content">
            <div class="explainability-header border-b-2 border-black pb-3 mb-4 flex items-center justify-between">
              <h3 class="font-black text-lg uppercase text-black flex items-center gap-2">
                <span>🔍</span> {m.db_operator_inspector()}: <span id="explain-node-name">Node Name</span>
              </h3>
              <span class="notebook-badge bg-color-chart-1 text-black font-black text-xs uppercase px-2 py-0.5 border-2 border-black" id="explain-node-type">Operator</span>
            </div>
            <div class="explainability-body space-y-4">
              <div class="explainability-text-section">
                <p id="explain-node-description" class="font-bold text-sm text-gray-700 leading-relaxed">Description of what happens inside this node...</p>
              </div>
              <div class="explainability-io-section grid grid-cols-1 md:grid-cols-11 gap-4 items-center">
                <div class="io-box md:col-span-5 border-2 border-black p-3 bg-gray-50">
                  <h4 class="font-black text-xs uppercase mb-2">{m.db_input_stream()}</h4>
                  <pre class="font-mono text-xs overflow-x-auto bg-black text-white p-2 border border-black"><code id="explain-node-input">...</code></pre>
                </div>
                <div class="io-arrow md:col-span-1 text-center font-black text-2xl text-black">➜</div>
                <div class="io-box md:col-span-5 border-2 border-black p-3 bg-gray-50">
                  <h4 class="font-black text-xs uppercase mb-2">{m.db_output_stream()}</h4>
                  <pre class="font-mono text-xs overflow-x-auto bg-black text-white p-2 border border-black"><code id="explain-node-output">...</code></pre>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Sidebar Inspector -->
      <aside class="sidebar-inspector">
        <div class="notebook-card border-4 border-black bg-white neo-shadow p-6 relative">
          <!-- Spiral visual effect -->
          <div class="notebook-spiral absolute -left-4 top-4 bottom-4 flex flex-col justify-around pointer-events-none select-none z-10">
            {[...Array(8)].map(() => (
              <span class="w-8 h-3 border-2 border-black bg-gray-200 inline-block rotate-90 rounded-full neo-shadow"></span>
            ))}
          </div>

          <div class="notebook-content pl-4">
            <div class="notebook-header border-b-2 border-black pb-3 mb-4 flex items-center justify-between">
              <h2 class="font-black text-xl uppercase text-black" id="inspector-title">{m.db_inspector_global_title()}</h2>
              <span class="notebook-badge bg-color-chart-3 text-black font-black text-xs uppercase px-2 py-0.5 border-2 border-black" id="inspector-badge">{m.db_inspector_global_badge()}</span>
            </div>

            <div class="notebook-body space-y-4 text-black">
              <!-- Stat Fields -->
              <div class="notebook-stat-row flex justify-between border-b border-gray-200 pb-2">
                <span class="label font-bold text-gray-500 uppercase text-xs">{m.db_inspector_status()}</span>
                <span class="value font-black text-sm" id="stat-status">Healthy</span>
              </div>
              <div class="notebook-stat-row flex justify-between border-b border-gray-200 pb-2">
                <span class="label font-bold text-gray-500 uppercase text-xs">{m.db_inspector_throughput()}</span>
                <span class="value font-black text-sm" id="stat-throughput">3.1M/s</span>
              </div>
              <div class="notebook-stat-row flex justify-between border-b border-gray-200 pb-2">
                <span class="label font-bold text-gray-500 uppercase text-xs">{m.db_inspector_latency()}</span>
                <span class="value font-black text-sm font-mono" id="stat-latency">2.0 ms</span>
              </div>
              <div class="notebook-stat-row flex justify-between border-b border-gray-200 pb-2">
                <span class="label font-bold text-gray-500 uppercase text-xs">{m.db_inspector_cpu()}</span>
                <span class="value font-black text-sm font-mono" id="stat-cpu">20%</span>
              </div>
              <div class="notebook-stat-row flex justify-between border-b border-gray-200 pb-2">
                <span class="label font-bold text-gray-500 uppercase text-xs">{m.db_inspector_mem()}</span>
                <span class="value font-black text-sm font-mono" id="stat-mem">5.0 Gb</span>
              </div>

              <!-- Special custom info row -->
              <div class="notebook-custom-section border-2 border-black p-4 bg-gray-50" id="inspector-custom-section">
                <h3 class="font-black text-xs uppercase mb-1">{m.db_inspector_custom_title()}</h3>
                <p id="inspector-custom-text" class="font-bold text-xs text-gray-700 leading-relaxed">
                  {m.db_inspector_custom_text()}
                </p>
              </div>

              <!-- Sparkline Chart -->
              <div class="notebook-chart-section border-2 border-black p-4 bg-white">
                <h3 class="font-black text-xs uppercase mb-2">{m.db_inspector_chart_title()}</h3>
                <div class="chart-container h-20 bg-gray-50 border border-black overflow-hidden relative">
                  <svg id="sparkline-svg" viewBox="0 0 300 80" preserveAspectRatio="none" class="w-full h-full">
                    <!-- Dynamic sparkline curve -->
                    <path id="sparkline-path" d="" fill="none" stroke="#2b8a3e" stroke-width="3"></path>
                  </svg>
                </div>
              </div>

              <!-- Notepad Event Log -->
              <div class="notebook-log-section border-2 border-black p-4 bg-white">
                <h3 class="font-black text-xs uppercase mb-2">{m.db_inspector_log_title()}</h3>
                <div class="log-console font-mono text-[10px] leading-relaxed max-h-24 overflow-y-auto space-y-1 text-gray-700 bg-gray-50 p-2 border border-black" id="log-console">
                  <div class="log-entry">[10:32:01] INFO: {lang === 'en' ? 'Pipeline successfully loaded.' : 'Pipeline caricata correttamente.'}</div>
                  <div class="log-entry">[10:32:05] INFO: {lang === 'en' ? 'Connecting to Banking Transactions source...' : "Connessione all'origine Operazioni Bancarie..."}</div>
                  <div class="log-entry">[10:32:10] INFO: {lang === 'en' ? 'Pipeline streaming active.' : 'Streaming pipeline attivo.'}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </aside>
    </main>
  </div>

  <!-- Load Simulation Logic -->
  <script is:inline src="/dashboard/app.js" defer></script>
</Layout>
