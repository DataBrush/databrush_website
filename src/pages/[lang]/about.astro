---
import Layout from '~/layouts/Layout.astro';
import { loadLocale, getLanguagePaths } from '~/lib/i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Server, BarChart, Zap, CheckCircle2 } from '@lucide/astro';
import { Image } from 'astro:assets';
import teamImg from 'public/assets/team.png';

export function getStaticPaths() {
  return getLanguagePaths();
}

const { lang } = Astro.params;
const m = loadLocale(lang);

const metadata = {
  title: m.about_page_title(),
  description: m.about_hero_subtitle()
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <section class="relative min-h-[40vh] flex items-center justify-center py-20 bg-background border-black">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#00000012_1px,transparent_1px),linear-gradient(to_bottom,#00000012_1px,transparent_1px)] bg-[size:30px_30px] -z-10"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Text Block -->
      <div class="flex flex-col gap-6 text-left">
        <span class="bg-color-chart-3 text-black font-black font-mono text-sm px-4 py-2 border-4 border-black neo-shadow uppercase tracking-wider w-fit">
          {m.about_tagline()}
        </span>
        <h1 class="text-4xl sm:text-6xl font-black uppercase text-black leading-none tracking-tight">
          <Fragment set:html={m.about_hero_title()} />
        </h1>
        <p class="text-lg sm:text-xl font-semibold text-gray-800 leading-relaxed max-w-4xl">
          <Fragment set:html={m.about_hero_subtitle()} />
        </p>
      </div>
    </div>
  </section>

  <!-- Team & Co-founders Section -->
  <section class="pb-20 bg-background border-b-4 border-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Team Image -->
      <div class="lg:col-span-7">
        <div class="border-4 border-black p-3 bg-white neo-shadow-lg">
          <Image src={teamImg} alt="Databrush Team" width={1200} class="w-full h-auto object-cover border-4 border-black" />
        </div>
      </div>
      
      <!-- Co-founders Info Box -->
      <div class="lg:col-span-5 border-4 border-black p-8 bg-color-chart-1 neo-shadow flex flex-col justify-center gap-4 text-black">
        <span class="font-mono font-black text-xs uppercase bg-black text-white px-3 py-1.5 w-fit border-2 border-black">CO-FOUNDERS</span>
        <div class="font-black text-3xl uppercase tracking-tighter leading-none">
          Luca, Fabio, Davide
        </div>
        <p class="font-bold text-base text-gray-900 leading-relaxed border-t-4 border-black pt-4">
          Supported by Gianpaolo and Alessandro from Politecnico di Milano.
        </p>
      </div>
    </div>
  </section>

  <!-- Strengths Section -->
  <section class="py-20 bg-secondary-background border-b-4 border-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center mb-16 max-w-3xl mx-auto">
        <h2 class="text-4xl sm:text-6xl font-black uppercase tracking-tight text-black mb-4">
          {m.about_strengths_title()}
        </h2>
        <p class="text-lg sm:text-xl font-extrabold text-gray-700 font-mono">
          // {m.about_strengths_subtitle()}
        </p>
      </div>

      <!-- Strengths Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          {
            title: m.about_strength_1_title(),
            desc: m.about_strength_1_description(),
            icon: Server,
            color: 'bg-color-chart-3'
          },
          {
            title: m.about_strength_2_title(),
            desc: m.about_strength_2_description(),
            icon: BarChart,
            color: 'bg-color-chart-1'
          },
          {
            title: m.about_strength_3_title(),
            desc: m.about_strength_3_description(),
            icon: Zap,
            color: 'bg-color-chart-2'
          }
        ].map(strength => (
          <div class="border-4 border-black p-8 bg-white neo-shadow flex flex-col gap-6">
            <div class={`w-14 h-14 border-4 border-black flex items-center justify-center ${strength.color} neo-shadow`}>
              <strength.icon class="w-8 h-8 text-black" />
            </div>
            <h3 class="font-black text-2xl uppercase tracking-tight text-black">
              {strength.title}
            </h3>
            <p class="font-bold text-gray-700 leading-relaxed">
              {strength.desc}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Values Section -->
  <section class="py-20 bg-background border-b-4 border-black">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      
      <!-- Section Header -->
      <div class="text-center mb-16">
        <h2 class="text-4xl sm:text-6xl font-black uppercase tracking-tight text-black mb-4">
          {m.about_values_title()}
        </h2>
        <p class="text-lg sm:text-xl font-extrabold text-gray-700 font-mono">
          // {m.about_values_subtitle()}
        </p>
      </div>

      <!-- Steps List -->
      <div class="space-y-12">
        {[
          {
            title: m.about_value_1_title(),
            desc: m.about_value_1_description(),
            color: 'bg-color-chart-2'
          },
          {
            title: m.about_value_2_title(),
            desc: m.about_value_2_description(),
            color: 'bg-color-chart-1'
          },
          {
            title: m.about_value_3_title(),
            desc: m.about_value_3_description(),
            color: 'bg-color-chart-3'
          }
        ].map((value, idx) => (
          <div class="flex flex-col md:flex-row gap-6 border-4 border-black p-8 bg-white neo-shadow">
            <!-- Number badge -->
            <div class={`w-16 h-16 border-4 border-black flex items-center justify-center font-black text-3xl shrink-0 neo-shadow ${value.color}`}>
              0{idx + 1}
            </div>
            <!-- Text Content -->
            <div class="flex flex-col gap-2">
              <h3 class="font-black text-2xl uppercase tracking-tight text-black">
                {value.title}
              </h3>
              <p class="font-bold text-gray-700 leading-relaxed">
                {value.desc}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
</Layout>
