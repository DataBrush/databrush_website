---
import { DOC_SLUGS } from '~/lib/docs';

export async function getStaticPaths() {
  return DOC_SLUGS.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const docSubpath = slug ? `/docs/${slug}/` : '/docs/';
const enTarget = `/en${docSubpath}`;
const itTarget = `/it${docSubpath}`;
const canonicalUrl = new URL(enTarget, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to Renoir Documentation...</title>
    <link rel="canonical" href={canonicalUrl} />
    <script define:vars={{ enTarget, itTarget }}>
      const userLang = (navigator.language || 'en').toLowerCase();
      const target = userLang.startsWith('it') ? itTarget : enTarget;
      window.location.replace(target + window.location.search + window.location.hash);
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${enTarget}`} />
    </noscript>
  </head>
  <body>
    <p>
      Redirecting to documentation...
      <a href={enTarget}>English</a> / <a href={itTarget}>Italiano</a>
    </p>
  </body>
</html>
