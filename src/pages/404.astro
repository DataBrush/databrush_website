---
// Root 404 page that redirects based on locale
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Redirecting...</title>
    <script is:inline>
      const pathname = window.location.pathname;
      if (pathname.startsWith('/it/') || pathname.startsWith('/it')) {
        window.location.href = '/it/404/';
      } else {
        window.location.href = '/en/404/';
      }
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/en/404/" />
    </noscript>
  </head>
  <body>
    <p>Redirecting to error page...</p>
  </body>
</html>
